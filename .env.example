# Copiar a .env y ajustar en cada laptop. NO subir el .env real a Git.

SECRET_KEY=cambia-esto

# BD principal (laptop A). Por defecto SQLite local.
# Ejemplo PostgreSQL:  postgresql://chinos:clave@localhost:5432/chinos
# DATABASE_URL=sqlite:///chinos_cafe.db

# --- Opción 1: BD réplica en Supabase mediante API REST (Laptop B) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Opción 2: BD réplica PostgreSQL directa (Supabase URI o VM) ---
# REPLICA_DATABASE_URL=postgresql://postgres.ref:clave@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Correo (opcional; si se deja vacío, el envío se simula en consola)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=clave-de-aplicacion
MAIL_EMPRESA=chinoscafe@example.com

# Flete sugerido si no hay retiro en sitio
FLETE=3.50
